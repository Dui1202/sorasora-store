{
    "ConnectionStrings": {
    "DefaultConnection": ""
  },
    "SupabaseStorage": {
    "Bucket": "store-images",
    "Region": "ap-northeast-1",
    "Endpoint": "https://lvzdygneaavbitvftzjk.storage.supabase.co/storage/v1/s3",
    "PublicBaseUrl":"https://lvzdygneaavbitvftzjk.supabase.co/storage/v1/object/public/store-images"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Properties": {
      "Application": "SoraSora.Api"
    }
  }
}
