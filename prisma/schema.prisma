generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Franchise {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?
  bannerUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([slug])
}

model Product {
  id                String           @id @default(cuid())
  name              String
  description       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  franchiseId       String?
  supplierCountry   SupplierCountry
  sellMode          SellMode         @default(IN_STOCK)
  preorderReleaseAt DateTime?
  franchise         Franchise?       @relation(fields: [franchiseId], references: [id])
  variants          ProductVariant[]
  variations        Variation[]
  productImages     ProductImage[]
  isPublished       Boolean          @default(false)
  hasVariation      Boolean          @default(false)
  isArchived        Boolean          @default(false)

  @@index([sellMode])
}

model ProductVariant {
  id               String               @id @default(cuid())
  productId        String
  sku              String               @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  name             String
  costPrice        Int
  sellingPrice     Int
  product          Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  image            ProductVariantImage?
  stocks           Stock[]
  position         Int                  @default(0)
  stockMovements   StockMovement[]
  variationOptions ProductVariantOption[]
  isArchived       Boolean              @default(false)
  allowFullPayment Boolean              @default(true)
  allowDeposit     Boolean              @default(false)
  depositPrice     Int?

  @@index([productId])
}

model Variation {
  id                    String                 @id @default(cuid())
  productId             String
  name                  String
  position              Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  options               VariationOption[]
  productVariantOptions ProductVariantOption[]

  @@unique([productId, name])
  @@index([productId])
  @@index([productId, position])
}

model VariationOption {
  id                    String                 @id @default(cuid())
  variationId           String
  value                 String
  position              Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  variation             Variation              @relation(fields: [variationId], references: [id], onDelete: Cascade)
  productVariantOptions ProductVariantOption[]

  @@unique([variationId, value])
  @@unique([id, variationId])
  @@index([variationId])
  @@index([variationId, position])
}

model ProductVariantOption {
  productVariantId String
  variationId      String
  variationOptionId String
  productVariant   ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  variation        Variation       @relation(fields: [variationId], references: [id], onDelete: Cascade)
  variationOption  VariationOption @relation(fields: [variationOptionId, variationId], references: [id, variationId], onDelete: Cascade)

  @@id([productVariantId, variationId])
  @@unique([productVariantId, variationOptionId])
  @@index([variationId])
  @@index([variationOptionId])
}

model ProductVariantImage {
  id        String         @id @default(cuid())
  variantId String         @unique
  path      String
  alt       String?
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  path      String
  alt       String?
  position  Int     @default(0)
  isCover   Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Warehouse {
  id        String          @id @default(cuid())
  name      String
  stocks    Stock[]
  movements StockMovement[]
}

model Stock {
  id          String         @id @default(cuid())
  variantId   String
  warehouseId String
  quantity    Int            @default(0)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
  @@index([variantId])
  @@index([warehouseId])
}

model StockMovement {
  id            String          @id @default(cuid())
  variantId     String?
  variantSku    String
  variantName   String
  warehouseId   String
  type          MovementType
  quantity      Int
  referenceId   String?
  note          String?
  createdAt     DateTime        @default(now())
  referenceType ReferenceType?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id])

  @@index([referenceId, referenceType])
  @@index([variantId])
  @@index([warehouseId])
  @@index([referenceId])
  @@index([createdAt])
}

model User {
  id            String         @id
  name          String
  email         String
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  shippingInfos ShippingInfo[]
  role          UserRole       @default(CUSTOMER)
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?      @db.Timestamptz(3)

  @@unique([email])
  @@map("user")
}

model ShippingInfo {
  id            String   @id @default(cuid())
  userId        String
  recipientName String
  phone         String
  addressLine   String
  district      String
  province      String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
}

model Cart {
  id String @id @default(cuid())

  userId         String? @unique
  guestCartToken String? @unique

  currencyCode String @default("VND")

  itemCount      Int @default(0)
  subtotalAmount Int @default(0)

  expiresAt      DateTime?
  lastActivityAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CartItem[]

  @@index([userId])
  @@index([guestCartToken])
}

model CartItem {
  id String @id @default(cuid())

  cartId    String
  productId String
  variantId String

  quantity Int

  productNamePreview String?
  variantNamePreview String?
  skuPreview         String?
  imagePathPreview   String?

  unitPricePreviewAmount Int?
  lineTotalPreviewAmount Int?

  sellModePreview SellMode?
  isSelected      Boolean   @default(true)

  preorderReleaseDatePreview DateTime?
  preorderEtaNotePreview     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerId    String?
  customerEmail String?
  customerName  String
  customerPhone String

  orderStatus       OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(UNPAID)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  currencyCode   String @default("VND")
  subtotalAmount Int
  discountAmount Int    @default(0)
  shippingAmount Int    @default(0)
  taxAmount      Int    @default(0)
  totalAmount    Int

  placedAt     DateTime?
  fullyPaidAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  note         String?
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer     User?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     OrderPayment[]
  shipments    Shipment[]
  refunds      OrderRefund[]
  orderAddress OrderAddress?
  orderEvents  OrderEvent[]

  @@index([customerId])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  productId String?
  variantId String?

  productNameSnapshot String
  variantNameSnapshot String?
  skuSnapshot         String?
  imageUrlSnapshot    String?

  sellModeSnapshot    SellMode
  releaseDateSnapshot DateTime?
  preorderStage       PreorderStage @default(NONE)

  unitPriceAmount   Int
  quantityOrdered   Int
  quantityCancelled Int @default(0)
  quantityFulfilled Int @default(0)
  quantityRefunded  Int @default(0)

  lineSubtotalAmount Int
  lineDiscountAmount Int @default(0)
  lineTotalAmount    Int

  requiresShipping    Boolean  @default(true)
  weightGramsSnapshot Int?
  taxRateSnapshot     Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order         Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipmentItems ShipmentItem[]
  refundItems   OrderRefundItem[]
}

model OrderAddress {
  id      String @id @default(cuid())
  orderId String @unique

  recipientName String
  phone         String
  province      String
  district      String
  addressLine   String

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderPayment {
  id       String              @id @default(cuid())
  orderId  String
  provider String
  method   String?
  status   PaymentRecordStatus

  amount       Int
  currencyCode String

  transactionReference String?
  paidAt               DateTime?
  createdAt            DateTime  @default(now())

  type OrderPaymentType @default(FULL_PAYMENT)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([transactionReference, provider])
  @@index([orderId])
}

model Shipment {
  id      String         @id @default(cuid())
  orderId String
  status  ShipmentStatus @default(PENDING)

  shipmentNumber String?   @unique
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ShipmentItem[]

  @@index([orderId])
}

model ShipmentItem {
  id          String @id @default(cuid())
  shipmentId  String
  orderItemId String
  quantity    Int

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
}

model OrderRefund {
  id        String       @id @default(cuid())
  orderId   String
  amount    Int
  reason    String?
  status    RefundStatus @default(PENDING)
  createdAt DateTime     @default(now())

  order Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items OrderRefundItem[]

  @@index([orderId])
}

model OrderRefundItem {
  id          String @id @default(cuid())
  refundId    String
  orderItemId String
  quantity    Int
  amount      Int

  refund    OrderRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([refundId, orderItemId])
}

model OrderEvent {
  id      String         @id @default(cuid())
  orderId String
  type    OrderEventType @default(ORDER_CREATED)

  actorType String?
  actorId   String?

  data      Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum SupplierCountry {
  CHINA
  JAPAN
}

enum SellMode {
  IN_STOCK
  PREORDER
}

enum MovementType {
  IN
  OUT
  RESERVE
  RELEASE
  ADJUST
}

enum ReferenceType {
  ORDER
  PURCHASE
  RETURN
  TRANSFER
  MANUAL
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING // order created but not confirmed (e.g., awaiting payment or review)
  CONFIRMED // order accepted (valid contract)
  CANCELLED // fully cancelled before completion
  COMPLETED // all items fulfilled and no outstanding actions
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID // deposit or partial capture
  PAID // fully paid
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED // all payment attempts failed
}

enum PaymentRecordStatus {
  PENDING // created but not processed yet
  AUTHORIZED // authorized but not captured
  CAPTURED // money successfully captured
  FAILED // failed attempt
  CANCELLED // manually cancelled before capture
  REFUNDED // fully refunded
  PARTIALLY_REFUNDED
}

enum OrderPaymentType {
  FULL_PAYMENT
  DEPOSIT
  BALANCE_PAYMENT
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED // all items returned
}

enum ShipmentStatus {
  PENDING // created but not processed
  READY // packed, waiting for carrier pickup
  SHIPPED // handed to carrier
  IN_TRANSIT
  DELIVERED
  FAILED // lost / failed delivery
  RETURNED // returned to sender
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED // refund executed successfully
  FAILED
}

enum OrderEventType {
  // Order lifecycle
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_CANCELLED

  // Payment lifecycle
  PAYMENT_CREATED
  PAYMENT_AUTHORIZED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  PAYMENT_CANCELLED

  // Preorder lifecycle (critical for your business)
  PREORDER_STAGE_CHANGED
  PREORDER_ETA_CHANGED
  PREORDER_DELAYED
  PREORDER_ARRIVED_AT_WAREHOUSE

  // Balance / deposit flow
  DEPOSIT_RECEIVED
  BALANCE_REQUESTED
  BALANCE_PAYMENT_RECEIVED

  // Fulfillment lifecycle
  FULFILLMENT_STARTED
  ITEM_ALLOCATED_TO_SHIPMENT

  // Shipment lifecycle
  SHIPMENT_CREATED
  SHIPMENT_READY
  SHIPMENT_SHIPPED
  SHIPMENT_DELIVERED
  SHIPMENT_FAILED
  SHIPMENT_RETURNED

  // Refund lifecycle
  REFUND_REQUESTED
  REFUND_APPROVED
  REFUND_REJECTED
  REFUND_PROCESSED
  REFUND_FAILED

  // System / admin actions
  NOTE_ADDED
  ORDER_UPDATED
}

enum PreorderStage {
  NONE
  AWAITING_RELEASE
  RELEASED
  INBOUND_TO_WAREHOUSE
  ARRIVED_AT_WAREHOUSE
  ALLOCATED_TO_SHIPMENT
  READY_FOR_FINAL_PAYMENT
  READY_TO_SHIP
  DELAYED
  CANCELLED_BY_SUPPLIER
}
